generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  admin
  scanner
}

enum RegistrationSource {
  form
  qr_walkin
  admin_manual
}

enum MessageChannel {
  email
  sms
  whatsapp
}

enum MessageStatus {
  queued
  sent
  failed
}

model Edition {
  id                 Int           @id @default(autoincrement())
  number             Int           @unique
  theme              String
  dates              String
  venue              String
  hasParticipantData Boolean       @default(false)
  // Jour principal de l'édition : sert au compte à rebours et aux échéances de la checklist du hub CIGIBM.
  eventDate          DateTime?
  participants       Participant[]
  createdAt          DateTime      @default(now())
}

model Ambassador {
  id                        String        @id @default(uuid())
  slug                      String        @unique
  fullName                  String
  phone                     String
  whatsappNumber            String?
  email                     String?
  photoUrl                  String?
  bio                       String?
  active                    Boolean       @default(true)
  participants              Participant[]
  createdAt                 DateTime      @default(now())

  // Suivi de l'automatisation de motivation quotidienne (cron
  // /api/cron/ambassador-nudges) : lastNudgeSentAt évite qu'un ambassadeur
  // reçoive deux nudges le même jour si le cron est rejoué ; il est mis à
  // jour par TOUT type de nudge (zéro parrainage ou palier atteint), pas un
  // champ par type. highestMilestoneCelebrated retient le dernier palier de
  // 5 déjà félicité, pour ne pas refêter le même total à chaque exécution
  // du cron tant qu'aucun nouveau palier n'est franchi.
  lastNudgeSentAt           DateTime?
  highestMilestoneCelebrated Int          @default(0)
}

model Participant {
  id                 String             @id @default(uuid())
  editionId          Int
  edition            Edition            @relation(fields: [editionId], references: [id])

  fullName           String
  phone              String
  email              String?
  consent            Boolean            @default(false)

  attendanceToken    String             @unique @default(cuid())
  registrationSource RegistrationSource

  ambassadorId       String?
  ambassador         Ambassador?        @relation(fields: [ambassadorId], references: [id])

  attendedAt         DateTime?
  checkedInByAdminId String?

  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([editionId, email])
  @@index([editionId])
  @@index([ambassadorId])
}

model AdminProfile {
  id         String    @id
  fullName   String
  role       AdminRole @default(scanner)
  testBypass Boolean   @default(false)
  createdAt  DateTime  @default(now())
  // Non nul = accès coupé immédiatement (vérifié à chaque requête par
  // getAdminSession), en plus du ban Supabase qui bloque les nouvelles
  // connexions mais pas une session déjà ouverte.
  suspendedAt DateTime?
}

model MessagingLog {
  id                String         @id @default(uuid())
  channel           MessageChannel
  recipientPhone    String?
  recipientEmail    String?
  participantId     String?
  subject           String?
  status            MessageStatus  @default(queued)
  providerMessageId String?
  errorMessage      String?
  batchId           String?
  batchLabel        String?
  sentByAdminId     String?
  sentAt            DateTime       @default(now())

  @@index([participantId])
  @@index([batchId])
}

enum LeadChannel {
  email
  whatsapp
}

// Personne qui a laissé ses coordonnées via le pop-up « bien-être mental » :
// pas une inscription à un événement, juste « recontactez-moi ». Un seul
// canal par personne (celui qu'elle a choisi), jamais les deux.
model Lead {
  id          String      @id @default(uuid())
  fullName    String
  channel     LeadChannel
  email       String?
  whatsapp    String?
  needsHelp   Boolean     @default(false)
  sourcePath  String?
  createdAt   DateTime    @default(now())
  contactedAt DateTime?

  @@index([createdAt])
}

enum ActivityAxis {
  humanitaire
  guerison
  autonomisation
}

enum ActivityStatus {
  en_cours
  en_projet
  terminee
}

// Une activité de l'ONG. Les trois axes reprennent l'objet déclaré au
// ministère de l'Intérieur (soutien humanitaire, guérison intérieure et
// bien-être mental, autonomisation). Rien n'apparaît sur le site tant que
// `published` est faux ; `internalNote` n'est jamais affichée au public.
model Activity {
  id           String         @id @default(uuid())
  slug         String         @unique
  title        String
  summary      String
  description  String?
  axis         ActivityAxis
  audience     String?
  status       ActivityStatus @default(en_projet)
  published    Boolean        @default(false)
  sortOrder    Int            @default(0)
  href         String?
  internalNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([axis, sortOrder])
}

enum ResourceKind {
  note
  file
}

enum ResourceCategory {
  cigibm
  ong
  institutionnel
  communication
  autre
}

// Dossier ressources de l'admin. Une note est un texte Markdown lu et modifié
// directement dans l'admin ; un fichier est un fichier du bucket privé « ressources »
// (jamais d'URL publique : lien signé de courte durée, voir lib/admin/resources.ts).
model Resource {
  id            String           @id @default(uuid())
  title         String
  category      ResourceCategory @default(autre)
  kind          ResourceKind
  body          String?
  filePath      String?
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  editionNumber Int?
  updatedByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category])
  @@index([editionNumber])
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskCategory {
  programme
  logistique
  communication
  partenaires
  finances
  bilan
}

// Checklist de préparation d'une édition du CIGIBM (hub /admin/cigibm).
model CigibmTask {
  id            String       @id @default(uuid())
  editionNumber Int
  title         String
  category      TaskCategory
  status        TaskStatus   @default(todo)
  dueDate       DateTime?
  owner         String?
  notes         String?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([editionNumber, category])
}

enum FunderKind {
  fondation
  agence_publique
  organisation_internationale
  ambassade
  entreprise
  ong_internationale
  reseau
  philanthrope
}

enum FunderStatus {
  a_contacter
  contacte
  en_discussion
  refuse
  finance
}

// Bailleurs et partenaires potentiels (admin, rubrique L'ONG). Uniquement des
// coordonnées publiées officiellement par l'organisation (sourceUrl + verifiedAt) :
// jamais d'email ou de numéro personnel de particulier.
model Funder {
  id             String       @id @default(uuid())
  name           String
  kind           FunderKind
  country        String
  scope          String?
  focus          String
  relevance      Int          @default(2)
  why            String?
  howToApply     String?
  website        String?
  applyUrl       String?
  contactEmail   String?
  contactPhone   String?
  contactFormUrl String?
  linkedinUrl    String?
  sourceUrl      String?
  verifiedAt     DateTime?
  // Prochaine date limite connue (appel à projets en cours) : remonte la fiche en tête de liste.
  deadline       DateTime?
  status         FunderStatus @default(a_contacter)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([kind])
}
